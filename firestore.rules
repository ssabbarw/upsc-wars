rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsUserRootDoc(userId) {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == userId;
    }

    /// Instagram link fields are set only by Cloud Functions (admin SDK).
    /// Uses merged document shape so partial `set(merge: true)` updates stay valid.
    function clientOkUserRootWrite() {
      return instaUserIdUnchanged()
        && instaLinkedAtUnchanged()
        && instaHandleUnchanged();
    }

    function instaUserIdUnchanged() {
      return (resource == null && !('insta_user_id' in request.resource.data))
        || (resource != null
          && (!('insta_user_id' in resource.data)
            || request.resource.data.insta_user_id == resource.data.insta_user_id));
    }

    function instaLinkedAtUnchanged() {
      return (resource == null && !('insta_linked_at' in request.resource.data))
        || (resource != null
          && (!('insta_linked_at' in resource.data)
            || request.resource.data.insta_linked_at == resource.data.insta_linked_at));
    }

    function instaHandleUnchanged() {
      return resource == null
        || !('insta_user_id' in resource.data)
        || !('insta' in request.resource.data)
        || request.resource.data.insta == resource.data.insta;
    }

    /// Share links (`session/{shareId}`): browser + app must read without auth.
    function sessionFieldKeysOk() {
      let ks = request.resource.data.keys();
      return ks.hasOnly(['kind', 'subject', 'uuids', 'schemaVersion', 'createdAt', 'sharedBy'])
        || ks.hasOnly(['kind', 'subject', 'topic', 'uuids', 'schemaVersion', 'createdAt', 'sharedBy'])
        || ks.hasOnly(['kind', 'subject', 'uuids', 'schemaVersion', 'createdAt'])
        || ks.hasOnly(['kind', 'subject', 'topic', 'uuids', 'schemaVersion', 'createdAt']);
    }

    function validSessionCreate() {
      let d = request.resource.data;
      return sessionFieldKeysOk()
        && d.kind is string
        && d.kind in ['battle', 'test', 'question']
        && d.subject is string
        && d.subject.size() > 0
        && d.subject.size() <= 200
        && (!('topic' in d)
          || (d.topic is string && d.topic.size() > 0 && d.topic.size() <= 200))
        && (!('sharedBy' in d)
          || (d.sharedBy is string && d.sharedBy.size() > 0 && d.sharedBy.size() <= 60))
        && d.uuids is list
        && d.uuids.size() > 0
        && d.uuids.size() <= 100
        && d.schemaVersion is int
        && d.schemaVersion == 1
        && d.createdAt == request.time;
    }

    /// Shared test leaderboard entries (`session/{shareId}/leaderboard/{id}`).
    /// Web players are not authenticated, so allow public create with strict shape validation.
    function leaderboardFieldKeysOk() {
      let ks = request.resource.data.keys();
      return ks.hasOnly(['name', 'score', 'attemptedAt', 'attemptedAtMs']);
    }

    function validLeaderboardCreate() {
      let d = request.resource.data;
      return leaderboardFieldKeysOk()
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 40
        && d.score is number
        && d.score >= 0
        && d.score <= 100
        && d.attemptedAt == request.time
        && d.attemptedAtMs is int
        && d.attemptedAtMs > 0;
    }

    match /session/{shareId} {
      allow read: if true;
      // Share links are created by the app. Allow unauthenticated create so
      // users can share even before sign-in; enforce strict schema validation.
      allow create: if shareId.size() >= 8
        && shareId.size() <= 128
        && validSessionCreate();
      allow update, delete: if false;

      match /leaderboard/{entryId} {
        allow read: if true;
        allow create: if validLeaderboardCreate();
        allow update, delete: if false;
      }
    }

    /// Community open challenges — public scores; clients enforce one attempt per user.
    match /open_challenges/{challengeId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if false;
    }

    /// Community presence for “Recents”: dense map under `buckets/{yyyy-m}/{day}/{0|3|…|21}`.
    match /buckets/{yearMonth}/{day}/{bucketId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    /// Community QOTD — one document per post (`attempts` + `reactions` maps by uid).
    function qotdAttemptsKeysSuperset() {
      let before = resource.data.get('attempts', {});
      let after = request.resource.data.get('attempts', {});
      return after.keys().hasAll(before.keys());
    }
    function qotdReactionsKeysSuperset() {
      let before = resource.data.get('reactions', {});
      let after = request.resource.data.get('reactions', {});
      return after.keys().hasAll(before.keys());
    }
    function qotdCountsNonDecreasing() {
      return request.resource.data.correct_count
          >= resource.data.get('correct_count', 0)
        && request.resource.data.wrong_count
          >= resource.data.get('wrong_count', 0);
    }
    match /qotd_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn()
        && request.resource.data.question_uuid == resource.data.question_uuid
        && request.resource.data.author_email == resource.data.author_email
        && request.resource.data.author_name == resource.data.author_name
        && request.resource.data.author_photo_url == resource.data.author_photo_url
        && request.resource.data.correct_option == resource.data.correct_option
        && request.resource.data.comment == resource.data.comment
        && request.resource.data.created_at == resource.data.created_at
        && qotdAttemptsKeysSuperset()
        && qotdReactionsKeysSuperset()
        && qotdCountsNonDecreasing();
      allow delete: if false;
    }

    /// Per-user block list: `users/{email}/blocked/{blockedEmail}` (doc ids are lowercased emails).
    /// `list` is owner-only. `get` also allows the blocked person to read the single doc whose id
    /// is their email ("has this person blocked me?"). Combining those in `allow read` makes
    /// collection queries fail — Firestore cannot prove every listed doc matches `blockedId`.
    match /users/{userId}/blocked/{blockedId} {
      allow list: if ownsUserRootDoc(userId);
      allow get: if signedIn()
        && request.auth.token.email != null
        && (
          request.auth.token.email.lower() == userId
          || request.auth.token.email.lower() == blockedId
        );
      allow write: if ownsUserRootDoc(userId);
    }

    /// `users/{lowercaseEmail}` — clients cannot forge Instagram verification fields.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if ownsUserRootDoc(userId) && clientOkUserRootWrite();
      allow update: if ownsUserRootDoc(userId) && clientOkUserRootWrite();
      allow delete: if false;
    }

    /// Mcq battles (`BattleFirestorePaths`): match doc + per-player sync docs.
    /// Host may prime the guest’s `joined_users` stub before the guest opens the invite.
    match /battle_matches/{sessionId} {
      allow read, write: if signedIn();

      match /joined_users/{participantId} {
        allow read, write: if signedIn();
      }

      match /joined_users_game_over_statuses/{participantId} {
        allow read, write: if signedIn();
      }
    }

    /// Daily current-affairs MCQs: `daily_mcqs/{year}/{month}/{day}` (read-only for clients).
    /// Public read — same as share links; pipeline writes via Admin SDK.
    match /daily_mcqs/{year}/{month}/{day} {
      allow read: if true;
      allow write: if false;
    }

    /// Daily CA ranks — public day meta; answers stay Functions-only.
    /// Clients must not write submissions or the leaderboard.
    match /daily_ca_days/{dateId} {
      allow read: if true;
      allow write: if false;

      match /private/{docId} {
        allow read, write: if false;
      }

      match /submissions/{uid} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /meta/{docId} {
        // Same as Daily War — catch-all excludes daily_ca_days, so this
        // nested match is the only client read grant. Deploy with the app.
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /daily_ca_state/{docId} {
      allow read, write: if false;
    }

    match /daily_ca_profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    /// Question corrections (`question_corrections/active`) — read-only on clients.
    match /question_corrections/{docId} {
      allow read: if true;
      allow write: if false;
    }

    /// In-app HTML announcement (`Long_Html_Message/message`).
    /// Public read so a push can open it before sign-in. Writes via Console / Admin SDK.
    match /Long_Html_Message/{docId} {
      allow read: if true;
      allow write: if false;
    }

    /// Global per-question analytics (`question_stats/{questionUuid}`).
    /// Docs are created on first client write — no pre-seeding required.
    /// Clients use silent anonymous Firebase Auth; rules require [signedIn] + validation.
    function isUuid(id) {
      return id.matches(
        '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
      );
    }

    function questionStatsKeysOk() {
      return request.resource.data.keys().hasOnly([
        'total_attempts',
        'correct_count',
        'incorrect_count',
        'option_a_count',
        'option_b_count',
        'option_c_count',
        'option_d_count',
        'total_time_seconds',
        'sure_attempt_count',
        'sure_wrong_count',
        'skipped_count',
        'first_attempt_correct_count',
        'report_count',
        'bookmarked_count',
        'updated_at',
      ]);
    }

    function questionStatsIntFieldOk(field, maxOnCreate, maxDelta) {
      let after = request.resource.data.get(field, 0);
      let before = resource == null ? 0 : resource.data.get(field, 0);
      return after is int
        && after >= 0
        && (resource == null
          ? after <= maxOnCreate
          : after >= before && after - before <= maxDelta);
    }

    function questionStatsCountersOk() {
      return questionStatsIntFieldOk('total_attempts', 100, 100)
        && questionStatsIntFieldOk('correct_count', 100, 100)
        && questionStatsIntFieldOk('incorrect_count', 100, 100)
        && questionStatsIntFieldOk('option_a_count', 100, 100)
        && questionStatsIntFieldOk('option_b_count', 100, 100)
        && questionStatsIntFieldOk('option_c_count', 100, 100)
        && questionStatsIntFieldOk('option_d_count', 100, 100)
        && questionStatsIntFieldOk('total_time_seconds', 72000, 72000)
        && questionStatsIntFieldOk('sure_attempt_count', 100, 100)
        && questionStatsIntFieldOk('sure_wrong_count', 100, 100)
        && questionStatsIntFieldOk('skipped_count', 100, 100)
        && questionStatsIntFieldOk('first_attempt_correct_count', 100, 100)
        && questionStatsIntFieldOk('report_count', 5, 5)
        && questionStatsIntFieldOk('bookmarked_count', 5, 5);
    }

    function validQuestionStatsWrite() {
      return questionStatsKeysOk()
        && questionStatsCountersOk()
        && request.resource.data.updated_at == request.time;
    }

    match /question_stats/{questionId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && isUuid(questionId)
        && validQuestionStatsWrite();
      allow delete: if false;
    }

    /// Per-session idempotency log (`question_stats_sync_log/{sessionId}`).
    match /question_stats_sync_log/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && isUuid(sessionId)
        && request.resource.data.keys().hasOnly(['updated_at', 'session_id'])
        && request.resource.data.session_id == sessionId
        && request.resource.data.updated_at == request.time;
      allow update, delete: if false;
    }

    /// Daily War — tonight's paper/topics are public (home can show them
    /// before Google/Apple sign-in). Answers, submissions, and ranks stay
    /// signed-in. Clients must not write papers (Cloud Functions only).
    match /daily_wars/{dateId} {
      allow read: if true;
      allow write: if false;

      match /private/{docId} {
        allow read, write: if false;
      }

      match /submissions/{uid} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /meta/{docId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /daily_war_state/{docId} {
      allow read, write: if false;
    }

    /// Lifetime Daily War badge tallies — owner read; Cloud Functions write.
    match /daily_war_profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    function isSuperUserEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'sachinsabbarwal@gmail.com',
          'upscwars@gmail.com',
          'tinyminyapps@gmail.com',
          'upscmcqpractice@gmail.com',
        ];
    }

    /// Admin-only English drafts. Students never read this collection.
    match /daily_ca_drafts/{dateId} {
      allow read: if isSuperUserEmail();
      allow write: if false;
    }

    /// CA Shots (FOMO Pulse) — public read so home can open them before
    /// Google/Apple sign-in (same pattern as daily_wars / daily_mcqs).
    /// Attempt sync stays signed-in via callable + fomo_pulse_user_state.
    /// Clients must not write pulses (Cloud Functions only).
    match /fomo_pulses/{pulseId} {
      allow read: if true;
      allow write: if false;
    }

    /// Per-user Pulse attempt index (one doc per uid). Server writes via callable.
    match /fomo_pulse_user_state/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    /// LLM API keys — Cloud Functions only. Never expose to clients.
    match /admin_secrets/{id} {
      allow read, write: if false;
    }

    function isAdminDashboardPath() {
      return request.path.matches(
        '/databases/' + database + '/documents/admin_dashboard(/.*)?'
      );
    }

    function isBotInternalPath() {
      return request.path.matches(
        '/databases/' + database + '/documents/bot_roster(/.*)?'
      ) || request.path.matches(
        '/databases/' + database + '/documents/bot_jobs(/.*)?'
      ) || request.path.matches(
        '/databases/' + database + '/documents/bot_state(/.*)?'
      );
    }

    function isAdminSecretsPath() {
      return request.path.matches(
        '/databases/' + database + '/documents/admin_secrets(/.*)?'
      );
    }

    function isDailyCaRanksPath() {
      return request.path.matches(
        '/databases/' + database + '/documents/daily_ca_days(/.*)?'
      ) || request.path.matches(
        '/databases/' + database + '/documents/daily_ca_state(/.*)?'
      ) || request.path.matches(
        '/databases/' + database + '/documents/daily_ca_profiles(/.*)?'
      );
    }

    /// Server-only bot traffic (Admin SDK). Clients cannot read or write.
    match /bot_roster/{id} {
      allow read, write: if false;
    }
    match /bot_jobs/{id} {
      allow read, write: if false;
    }
    match /bot_state/{id} {
      allow read, write: if false;
    }

    function isTrafficBotsDoc() {
      return request.path.matches(
        '/databases/' + database + '/documents/admin_dashboard/traffic_bots'
      );
    }

    function isBotBattlesPath() {
      return request.path.matches(
        '/databases/' + database + '/documents/admin_dashboard/bot_battles(/.*)?'
      );
    }

    /// Super-user CA generate clock (hour/minute IST). Functions also write here.
    match /admin_dashboard/daily_ca {
      allow read, write: if isSuperUserEmail();
    }

    /// Super-user bot index — Cloud Functions only. Clients must not overwrite.
    match /admin_dashboard/traffic_bots {
      allow read: if isSuperUserEmail();
      allow write: if false;
    }

    /// Bot battle join/complete log — Cloud Functions only. Super users read.
    match /admin_dashboard/bot_battles {
      allow read: if isSuperUserEmail();
      allow write: if false;
    }
    match /admin_dashboard/bot_battles/{path=**} {
      allow read: if isSuperUserEmail();
      allow write: if false;
    }

    /// In-app admin dashboard metrics — super users read; clients write aggregates.
    match /admin_dashboard/{path=**} {
      allow read: if isSuperUserEmail();
      allow write: if signedIn() && !isTrafficBotsDoc() && !isBotBattlesPath();
    }

    /// Owner-only copy of blocked emails, keyed by Auth uid (always on the token).
    match /block_lists/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Authenticated users: all other collections (tighten per collection before prod if needed).
    match /{document=**} {
      allow read, write: if signedIn()
        && !isUsersRootDoc(database)
        && !isUsersBlockedPath(database)
        && !isBlockListsPath(database)
        && !isAdminDashboardPath()
        && !isBotInternalPath()
        && !isAdminSecretsPath()
        && !isDailyCaRanksPath();
    }

    function isUsersRootDoc(database) {
      return request.path.matches('/databases/' + database + '/documents/users/[^/]+$');
    }

    function isUsersBlockedPath(database) {
      return request.path.matches(
        '/databases/' + database + '/documents/users/[^/]+/blocked(/.*)?'
      );
    }

    function isBlockListsPath(database) {
      return request.path.matches(
        '/databases/' + database + '/documents/block_lists(/.*)?'
      );
    }
  }
}
