rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function authedEmailLower() {
      return signedIn()
          && request.auth.token.email is string
          ? lower(request.auth.token.email)
          : '';
    }

    function matchDoc(sessionId) {
      return get(/databases/$(database)/documents/battle_matches/$(sessionId)).data;
    }

    function isMatchParticipant(sessionId, participantId) {
      let m = matchDoc(sessionId);
      return authedEmailLower() == participantId
        || authedEmailLower() == m.host_email
        || (m.guest_email != null && authedEmailLower() == m.guest_email)
        || (m.battle_mode == 'bot'
            && participantId == 'opponent'
            && authedEmailLower() == m.host_email);
    }

    function canWriteJoinedUserDoc(sessionId, participantId) {
      let m = matchDoc(sessionId);
      return authedEmailLower() == participantId
        || (m.battle_mode == 'bot'
            && participantId == 'opponent'
            && authedEmailLower() == m.host_email);
    }

    // Community reads many user profiles; writes are limited to the signed-in doc id.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
          && userId == authedEmailLower();
    }

    // Presence map: one top-level field per user email (legacy shape).
    // Writes use set(merge: true); each user may only create/update their own key.
    match /buckets/{ym}/{day}/{bucketId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && authedEmailLower() != ''
        && request.resource.data.keys().hasOnly([authedEmailLower()])
        && request.resource.data[authedEmailLower()] is map;

      allow update: if signedIn()
        && authedEmailLower() != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([authedEmailLower()])
        && request.resource.data[authedEmailLower()] is map;
    }

    match /battle_matches/{sessionId} {
      allow read: if signedIn();

      allow create: if signedIn()
          && request.resource.data.host_email == authedEmailLower()
          && request.resource.data.battle_mode in ['human', 'bot']
          && request.resource.data.question_uuids is list;

      allow update: if signedIn() && (
          (
            resource.data.guest_email == authedEmailLower()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['guest_ready', 'num_of_players_joined'])
            && request.resource.data.guest_ready == true
            && request.resource.data.num_of_players_joined == 2
          )
          || (
            resource.data.host_email == authedEmailLower()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['lets_start_game'])
            && request.resource.data.lets_start_game == true
          )
        );

      match /joined_users/{participantId} {
        allow read: if signedIn() && isMatchParticipant(sessionId, participantId);
        allow create, update: if signedIn()
            && canWriteJoinedUserDoc(sessionId, participantId);
      }

      match /joined_users_game_over_statuses/{participantId} {
        allow read: if signedIn() && isMatchParticipant(sessionId, participantId);
        allow create, update: if signedIn()
            && canWriteJoinedUserDoc(sessionId, participantId);
      }
    }

    // Shared practice links (HTTPS upscwars.com/share/... + web player + app resolver).
    // Reads are public so the browser can load questions via REST without auth.
    // Writes only for signed-in app users creating a new share doc.
    match /session/{shareId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['kind', 'subject', 'uuids', 'schemaVersion'])
        && request.resource.data.kind is string
        && request.resource.data.kind in ['battle', 'test', 'question']
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 240
        && request.resource.data.uuids is list
        && request.resource.data.uuids.size() > 0
        && request.resource.data.uuids.size() <= 200
        && request.resource.data.schemaVersion == 1
        && (!('topic' in request.resource.data)
            || (request.resource.data.topic is string
                && request.resource.data.topic.size() <= 240));

      allow update, delete: if false;
    }
  }
}
