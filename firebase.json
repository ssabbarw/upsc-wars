{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": []
    },
    {
      "source": "daily-current-mcqs",
      "codebase": "ca-generate",
      "runtime": "python312",
      "ignore": [
        "venv",
        "venv/**",
        "venv-py39-local",
        "venv-py39-local/**",
        ".env",
        ".env.*",
        "*.local",
        "firebase_credentials.json",
        "logs",
        "preview/*.json",
        "__pycache__",
        ".git",
        "*.pyc",
        ".DS_Store"
      ]
    }
  ]
}
