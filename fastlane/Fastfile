require "json"

opt_out_usage

default_platform(:android)

APP_BUNDLE_ID = "tinyminyapps.upsc.wars"
EXTENSION_BUNDLE_ID = "tinyminyapps.upsc.wars.MakePulse"
ANDROID_PACKAGE = "practice.upsc.indiaapps.com.upscmcqpractice"
TEAM_ID = "PJFA69Q3GT"

def repo_root
  File.expand_path("..", __dir__)
end

# bundle exec sets RUBYOPT and GEM_HOME so only Gemfile gems are visible.
# Flutter shells out to `pod`. CocoaPods is installed beside the Gemfile, so
# drop Bundler's sandbox for that child process, then restore it.
def without_bundler_sandbox
  keys = %w[RUBYOPT BUNDLE_GEMFILE BUNDLE_BIN_PATH BUNDLE_PATH BUNDLER_SETUP BUNDLER_VERSION]
  gem_home = ENV["COCOAPODS_GEM_HOME"].to_s
  keys += %w[GEM_HOME GEM_PATH PATH] unless gem_home.empty?
  saved = keys.to_h { |key| [key, ENV[key]] }
  %w[RUBYOPT BUNDLE_GEMFILE BUNDLE_BIN_PATH BUNDLE_PATH BUNDLER_SETUP BUNDLER_VERSION].each do |key|
    ENV.delete(key)
  end
  unless gem_home.empty?
    ENV["GEM_HOME"] = gem_home
    ENV["GEM_PATH"] = gem_home
    ENV["PATH"] = "#{File.join(gem_home, "bin")}#{File::PATH_SEPARATOR}#{saved["PATH"]}"
  end
  yield
ensure
  saved&.each do |key, value|
    if value.nil?
      ENV.delete(key)
    else
      ENV[key] = value
    end
  end
end

def pubspec_build_number
  pubspec = File.read(File.join(repo_root, "pubspec.yaml"))
  match = pubspec.match(/^version:\s+\d+\.\d+\.\d+\+(\d+)\s*$/)
  UI.user_error!("pubspec.yaml version must look like 2047.0.0+2047") unless match
  match[1].to_i
end

# Stores reject a build number that was already uploaded. Use the higher of the
# pubspec number and one past the store, and keep the existing N.0.0+N scheme.
def next_store_version(uploaded_build_number)
  code = [pubspec_build_number, uploaded_build_number.to_i + 1].max
  version = "#{code}.0.0+#{code}"
  File.write(File.join(repo_root, ".next_store_version"), version)
  UI.success("Next store version #{version}")
  version
end

def play_version_codes(json_key, track)
  google_play_track_version_codes(
    package_name: ANDROID_PACKAGE,
    track: track,
    json_key_data: json_key,
  )
rescue StandardError => error
  UI.message("Play track #{track} has no version codes yet.")
  UI.message(error.message.to_s.lines.first.to_s.strip)
  []
end

def dart_define_args
  path = File.join(repo_root, "dart_defines.json")
  UI.user_error!("dart_defines.json is missing. The workflow writes it before Fastlane runs.") unless File.exist?(path)
  ["--dart-define-from-file=#{path}"]
end

platform :android do
  desc "Pick a versionCode higher than Play and pubspec.yaml."
  lane :next_version do
    json_key = ENV["PLAY_STORE_JSON_KEY"].to_s
    UI.user_error!("Set the PLAY_STORE_JSON_KEY secret to the Play Console service account JSON.") if json_key.empty?
    JSON.parse(json_key)

    tracks = %w[internal alpha beta production]
    selected = ENV["PLAY_TRACK"].to_s.strip
    tracks << selected unless selected.empty?
    uploaded = tracks.uniq.flat_map { |track| play_version_codes(json_key, track) }.map(&:to_i).max || 0
    next_store_version(uploaded)
  end

  desc "Upload the signed App Bundle to Play production, unless PLAY_TRACK overrides it."
  lane :upload do
    json_key = ENV["PLAY_STORE_JSON_KEY"].to_s
    UI.user_error!("Set the PLAY_STORE_JSON_KEY secret to the Play Console service account JSON.") if json_key.empty?
    JSON.parse(json_key)

    track = ENV["PLAY_TRACK"].to_s.strip
    track = "production" if track.empty?

    aab = File.join(repo_root, "build/app/outputs/bundle/release/app-release.aab")
    UI.user_error!("App Bundle not found at #{aab}") unless File.exist?(aab)

    options = {
      track: track,
      release_status: "completed",
      aab: aab,
      json_key_data: json_key,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    }
    mapping = File.join(repo_root, "build/app/outputs/mapping/release/mapping.txt")
    options[:mapping] = mapping if File.exist?(mapping)

    upload_to_play_store(options)
  end
end

platform :ios do
  desc "Sign a release IPA and submit it for public App Store release."
  lane :upload do
    key_id = ENV["ASC_KEY_ID"].to_s
    issuer_id = ENV["ASC_ISSUER_ID"].to_s
    key_content = ENV["ASC_KEY_P8"].to_s
    if key_id.empty? || issuer_id.empty? || key_content.empty?
      UI.user_error!("Set ASC_KEY_ID, ASC_ISSUER_ID, and ASC_KEY_P8.")
    end

    profiles_path = File.join(repo_root, "ios/signing_profiles.json")
    UI.user_error!("ios/signing_profiles.json is missing. The workflow writes it from the provisioning profile secrets.") unless File.exist?(profiles_path)
    profiles = JSON.parse(File.read(profiles_path))
    [APP_BUNDLE_ID, EXTENSION_BUNDLE_ID].each do |bundle_id|
      UI.user_error!("No provisioning profile installed for #{bundle_id}") if profiles[bundle_id].to_s.empty?
    end

    apply_manual_signing(profiles)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: true,
    )

    uploaded = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_BUNDLE_ID,
      initial_build_number: 0,
    )
    version_name, version_code = next_store_version(uploaded).split("+", 2)

    without_bundler_sandbox do
      sh("pod", "--version")
      sh(
        "flutter", "build", "ipa", "--release",
        "--build-name=#{version_name}",
        "--build-number=#{version_code}",
        *dart_define_args,
        "--export-options-plist=#{File.join(repo_root, "ios/ExportOptions.plist")}"
      )
    end

    ipa = Dir[File.join(repo_root, "build/ios/ipa/*.ipa")].first
    UI.user_error!("IPA was not created under build/ios/ipa") if ipa.nil?

    upload_to_app_store(
      api_key: api_key,
      ipa: ipa,
      submit_for_review: true,
      automatic_release: true,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
        content_rights_has_rights: true,
      },
    )
  end
end

def apply_manual_signing(profiles)
  require "xcodeproj"
  project = Xcodeproj::Project.open(File.join(repo_root, "ios/Runner.xcodeproj"))
  targets = {
    "Runner" => profiles.fetch(APP_BUNDLE_ID),
    "ShareExtension" => profiles.fetch(EXTENSION_BUNDLE_ID),
  }
  project.targets.each do |target|
    profile_name = targets[target.name]
    next if profile_name.nil?

    target.build_configurations.each do |config|
      next unless config.name == "Release"

      config.build_settings["CODE_SIGN_STYLE"] = "Manual"
      config.build_settings["DEVELOPMENT_TEAM"] = TEAM_ID
      config.build_settings["CODE_SIGN_IDENTITY"] = "Apple Distribution"
      config.build_settings["PROVISIONING_PROFILE_SPECIFIER"] = profile_name
    end
  end
  project.save
end
