<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ SplashScreen API: without these, the system can show a blank icon. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/upsc_brand_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_brand_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/upsc_brand_dark</item>
    </style>
</resources>
