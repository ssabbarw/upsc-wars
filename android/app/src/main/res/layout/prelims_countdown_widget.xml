<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prelims_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prelims_widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/prelims_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UPSC PRELIMS"
        android:textAllCaps="true"
        android:textColor="#FF1A3A5A"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/prelims_labels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Days"
        android:textColor="#FF1D4E75"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/prelims_timer_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Days: 0"
        android:textColor="#FF0E2438"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/prelims_quote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="“The trouble is, you think you have time.” by Buddha"
        android:textColor="#FF1D4E75"
        android:textSize="13sp" />

</LinearLayout>
