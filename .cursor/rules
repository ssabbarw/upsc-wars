## Design System

### Font

**Always use DM Sans from google_fonts. Never use any other font.**

```dart
import 'package:google_fonts/google_fonts.dart';

// Usage in ThemeData:
textTheme: GoogleFonts.dmSansTextTheme(Theme.of(context).textTheme)

// Usage inline:
style: GoogleFonts.dmSans(fontSize: 15, fontWeight: FontWeight.w500)
```

Font weight rules:
- Regular body text: FontWeight.w400
- Labels, titles, buttons: FontWeight.w500
- Never use w600, w700, or w800 — too heavy for this UI

---

### Color Tokens — app_colors.dart

Define ALL colors as static constants. Never hardcode hex values anywhere else in the codebase.

```dart
class AppColors {

  // ── Primary accent (teal-green) ──────────────────────────────────────
  static const primary          = Color(0xFF1D9E75);
  static const primaryLight     = Color(0xFFE1F5EE); // backgrounds, selected states light
  static const primaryDark      = Color(0xFF0F6E56); // darker variant
  static const primaryDeep      = Color(0xFF085041); // text on primaryLight bg

  // ── Semantic: correct / wrong ─────────────────────────────────────────
  static const correct          = Color(0xFF1D9E75);
  static const correctBg        = Color(0xFFE1F5EE); // light mode
  static const correctBgDark    = Color(0xFF085041); // dark mode
  static const correctText      = Color(0xFF085041); // text on correctBg light
  static const correctTextDark  = Color(0xFF9FE1CB); // text on correctBgDark

  static const wrong            = Color(0xFFE24B4A);
  static const wrongBg          = Color(0xFFFCEBEB); // light mode
  static const wrongBgDark      = Color(0xFF501313); // dark mode
  static const wrongText        = Color(0xFF791F1F); // text on wrongBg light
  static const wrongTextDark    = Color(0xFFF09595); // text on wrongBgDark

  // ── Semantic: warning / flagged ───────────────────────────────────────
  static const warning          = Color(0xFFBA7517);
  static const warningBg        = Color(0xFFFAEEDA); // light mode
  static const warningBgDark    = Color(0xFF412402); // dark mode
  static const warningText      = Color(0xFF633806); // text on warningBg light
  static const warningTextDark  = Color(0xFFFAC775); // text on warningBgDark

  // ── Semantic: info / exam mode ────────────────────────────────────────
  static const info             = Color(0xFF185FA5);
  static const infoBg           = Color(0xFFE6F1FB); // light mode
  static const infoBgDark       = Color(0xFF042C53); // dark mode
  static const infoText         = Color(0xFF0C447C); // text on infoBg light
  static const infoTextDark     = Color(0xFFB5D4F4); // text on infoBgDark

  // ── Neutral grays ────────────────────────────────────────────────────
  static const gray50           = Color(0xFFF1EFE8);
  static const gray100          = Color(0xFFD3D1C7);
  static const gray200          = Color(0xFFB4B2A9);
  static const gray400          = Color(0xFF888780);
  static const gray600          = Color(0xFF5F5E5A);
  static const gray800          = Color(0xFF444441);
  static const gray900          = Color(0xFF2C2C2A);

  // ── Light mode surfaces ───────────────────────────────────────────────
  static const surfacePrimaryLight    = Color(0xFFFFFFFF);
  static const surfaceSecondaryLight  = Color(0xFFF5F5F3);
  static const surfaceTertiaryLight   = Color(0xFFEEEEEB);

  // ── Dark mode surfaces ────────────────────────────────────────────────
  static const surfacePrimaryDark     = Color(0xFF1C1C1E);
  static const surfaceSecondaryDark   = Color(0xFF2C2C2E);
  static const surfaceTertiaryDark    = Color(0xFF3A3A3C);

  // ── Border colors ─────────────────────────────────────────────────────
  static const borderLight      = Color(0x26000000); // 15% black
  static const borderDark       = Color(0x26FFFFFF); // 15% white

  // ── Streak / fire ────────────────────────────────────────────────────
  static const streak           = Color(0xFFE24B4A);
}
```

